{
  "name": "ridy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run validate:dist",
    "preview": "vite preview",
    "smoke:preview": "bash scripts/smoke-preview.sh",
    "test": "node --experimental-strip-types --test tests/*.test.mjs && npm run validate:model",
    "validate:model": "node scripts/validate-model.mjs",
    "validate:dist": "node scripts/validate-dist.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.4",
    "@react-three/fiber": "^9.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.179.1",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
